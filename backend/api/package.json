{
    "name": "trilhas-api",
    "version": "1.0.0",
    "type": "module",
    "description": "API base para identificação de trilhas sonoras",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "migrate": "tsx scripts/migrate.ts",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.478.0",
        "amqplib": "^0.10.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "multer": "^1.4.5-lts.1",
        "pg": "^8.11.3",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/amqplib": "^0.10.4",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.10.0",
        "@types/pg": "^8.10.9",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/uuid": "^9.0.7",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    }
}
